POSTGRES_USER=scanner
POSTGRES_PASSWORD=change_me
POSTGRES_DB=scanner

# SSRF protection: keep false except for isolated local lab testing
ALLOW_PRIVATE_NETWORK_TARGETS=false

# Local (non-docker) backend settings
DATABASE_URL=sqlite:///./scanner.db
MAX_CRAWL_DEPTH_LIMIT=5
MAX_URLS_LIMIT=500
REQUEST_TIMEOUT_SECONDS=10
