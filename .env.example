POSTGRES_USER=scanner
POSTGRES_PASSWORD=change_me
POSTGRES_DB=scanner

# SSRF protection: keep false in production deployments
ALLOW_PRIVATE_NETWORK_TARGETS=false

# Dedicated local-development testing (scanning host web applications from Docker):
# Disabled by default. When true, permits scanning authorized host applications
# (localhost, 127.0.0.1, host.docker.internal) on user-selected ports.
ALLOW_LOCAL_DEV_TARGET=false

# Local (non-docker) backend settings
DATABASE_URL=sqlite:///./scanner.db
MAX_CRAWL_DEPTH_LIMIT=5
MAX_URLS_LIMIT=500
REQUEST_TIMEOUT_SECONDS=10
